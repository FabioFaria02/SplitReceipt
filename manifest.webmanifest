{
  "id": "./?app=splitreceipt-gh",
  "name": "SplitReceipt",
  "short_name": "SplitReceipt",
  "description": "Divide recibos entre amigos com leitura por IA, tradução e conversão para euros.",
  "lang": "pt-PT",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#0a0d1a",
  "theme_color": "#0c0f1d",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Novo recibo",
      "short_name": "Recibo",
      "url": "./?action=add",
      "icons": [
        {
          "src": "icons/shortcut-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Despesa sem recibo",
      "short_name": "Despesa",
      "url": "./?action=expense",
      "icons": [
        {
          "src": "icons/shortcut-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Histórico",
      "url": "./?action=history",
      "icons": [
        {
          "src": "icons/shortcut-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "receipts",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic"
          ]
        }
      ]
    }
  }
}
